# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Build output
bin/
golan
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.*
!.env.example

# Runtime sessions, captures, and local telemetry
.golan-session.json
.config/goLAN/
goLAN-sessions/
sessions/
pcaps/
captures/
logs/
*.pcap
*.pcapng
*.cap
*.log
*.log.*
*.jsonl
*.ndjson

# Local secrets and lab credentials
*.pem
*.key
*.p12
*.pfx
*.kdbx

# Editor/IDE
# .idea/
# .vscode/
